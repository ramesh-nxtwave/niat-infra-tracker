{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:setup-evidence-gc": "pnpm --package=tsx dlx tsx src/scripts/setup-evidence-gc.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --package=tsx dlx tsx --test \"src/**/*.test.{js,jsx,ts,tsx}\" && pnpm run test:startup",
    "test:startup": "node ./scripts/check-built-startup.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "^5.22.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@supabase/supabase-js": "^2.45.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.39.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "thread-stream": "3.1.0"
  }
}
